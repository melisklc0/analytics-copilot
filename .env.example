PROJECT_NAME="Analytics Copilot"
VERSION="0.1.0"
ENVIRONMENT="dev"
LOG_LEVEL="INFO"

CORE_API_PORT=8090

# PostgreSQL (superuser — used only by seed script)
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="analytics_copilot"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"

# Read-only role — used by SQL executor (analyst_ro)
POSTGRES_RO_USER="analyst_ro"
POSTGRES_RO_PASSWORD="analyst_ro"

OPENAI_API_KEY=""

LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# Legacy / reference — from OpenRAG skeleton
DATABASE_URL=""
QDRANT_HOST="qdrant"
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="openrag_documents"
