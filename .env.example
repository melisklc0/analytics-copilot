PROJECT_NAME="Analytics Copilot"
VERSION="0.1.0"
ENVIRONMENT="dev"
LOG_LEVEL="INFO"

CORE_API_PORT=8090

# PostgreSQL (superuser — used only by seed script)
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="analytics_copilot"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"

# Read-only role — used by SQL executor (analyst_ro)
POSTGRES_RO_USER="analyst_ro"
POSTGRES_RO_PASSWORD="analyst_ro"

# SQL executor limits
SQL_ROW_LIMIT=500
SQL_STATEMENT_TIMEOUT_MS=10000

# Superset metadata DB (separate postgres instance)
SUPERSET_DB_NAME=superset
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=superset

# Superset secrets — CHANGE IN PRODUCTION
SUPERSET_SECRET_KEY=local-dev-secret-key-change-in-prod
GUEST_TOKEN_JWT_SECRET=guest-token-secret-change-in-prod

# Superset admin
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_EMAIL=admin@analytics-copilot.local
SUPERSET_ADMIN_PASSWORD=admin

# Superset port
SUPERSET_PORT=8088

# Wildcard origins for CSP frame-ancestors + EMBED_ALLOWED_DOMAINS (patched_same_origin handles wildcards)
EMBED_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# Exact origins for CORS pre-flight — Flask-CORS has no wildcard support. Falls back to EMBED_ALLOWED_ORIGINS if unset.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# dbt — path to compiled manifest.json (generated by `dbt docs generate`)
DBT_MANIFEST_PATH="dbt/target/manifest.json"

# Prompt templates directory (relative to project root)
PROMPTS_DIR="prompts"

OPENAI_API_KEY=""
# OpenAI model used by SQL generator and result formatter
OPENAI_MODEL="gpt-4o-mini"

# Langfuse — self-hosted: set HOST to http://localhost:3000 and fill API keys after first login
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# Langfuse self-hosted infra — used by docker-compose only
LANGFUSE_PORT=3000
LANGFUSE_NEXTAUTH_SECRET="langfuse-dev-nextauth-secret-change-in-prod"
LANGFUSE_SALT="langfuse-dev-salt-change-in-prod"
LANGFUSE_POSTGRES_PASSWORD="langfuse"
LANGFUSE_CLICKHOUSE_USER="default"
LANGFUSE_CLICKHOUSE_PASSWORD="langfuse"
LANGFUSE_MINIO_ACCESS_KEY="minio"
LANGFUSE_MINIO_SECRET_KEY="miniosecret"
LANGFUSE_INIT_USER_EMAIL="admin@analytics-copilot.local"
LANGFUSE_INIT_USER_PASSWORD="copilotadmin123." # CHANGE IN PRODUCTION

# Legacy / reference — from OpenRAG skeleton
DATABASE_URL=""
QDRANT_HOST="qdrant"
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="openrag_documents"
