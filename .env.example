PROJECT_NAME="Analytics Copilot"
VERSION="0.1.0"
ENVIRONMENT="dev"
LOG_LEVEL="INFO"

CORE_API_PORT=8090

# PostgreSQL (superuser — used only by seed script)
POSTGRES_HOST="analytics-copilot-db"
POSTGRES_PORT=5432
POSTGRES_DB="analytics_copilot"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"

# Read-only role — used by SQL executor (analyst_ro)
POSTGRES_RO_USER="analyst_ro"
POSTGRES_RO_PASSWORD="analyst_ro"

# Read-only role — used by Superset's warehouse connection (superset_ro).
# Dedicated per-consumer service account (least-privilege, independent rotation
# and audit). Must match the role in infra/postgres/init.sql. The dashboard
# import builds sqlalchemy_uri from these — never hardcoded in the script.
SUPERSET_RO_USER="superset_ro"
SUPERSET_RO_PASSWORD="superset_ro"

# SQL executor limits
SQL_ROW_LIMIT=500
SQL_STATEMENT_TIMEOUT_MS=10000

# Superset metadata DB (separate postgres instance)
SUPERSET_DB_NAME=superset
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=superset

# Superset secrets — CHANGE IN PRODUCTION
SUPERSET_SECRET_KEY=local-dev-secret-key-change-in-prod
GUEST_TOKEN_JWT_SECRET=guest-token-secret-change-in-prod

# Superset admin
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_EMAIL=admin@analytics-copilot.local
SUPERSET_ADMIN_PASSWORD=admin

# Superset port
SUPERSET_PORT=8088

# Streamlit console (analytics-copilot-ui container) → host port.
# 8502 by default so it doesn't clash with agentic-rag's UI on 8501.
STREAMLIT_PORT=8502
# Embedded Superset dashboard (Dashboard tab, guest-token flow).
# SUPERSET_URL          — browser-reachable origin returned to the embed SDK.
# SUPERSET_INTERNAL_URL — how the API reaches Superset inside the Docker network.
# SUPERSET_DASHBOARD_ID — numeric id or slug to embed (empty → setup hint).
# SUPERSET_EMBED_ALLOWED_DOMAINS — origins allowed to host the embedded iframe;
#   the API sets these when it auto-enables embedding on the dashboard.
SUPERSET_URL="http://localhost:8088"
SUPERSET_INTERNAL_URL="http://superset:8088"
# Defaults to the committed demo dashboard (auto-imported by superset-import).
SUPERSET_DASHBOARD_ID="brazil_ecommerce"
SUPERSET_EMBED_ALLOWED_DOMAINS="http://localhost:8502"
# Backend the console calls. In Docker this is overridden to the in-network
# hostname (http://analytics-copilot-api:8090); this value is for local runs.
CORE_API_URL="http://localhost:8090"

# Wildcard origins for CSP frame-ancestors + EMBED_ALLOWED_DOMAINS (patched_same_origin handles wildcards).
# localhost:8502 is the Streamlit console — it must be listed or the Dashboard-tab iframe is blocked.
EMBED_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8502
# Exact origins for CORS pre-flight — Flask-CORS has no wildcard support. Falls back to EMBED_ALLOWED_ORIGINS if unset.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8502

# dbt — path to compiled manifest.json (generated by `dbt docs generate`)
DBT_MANIFEST_PATH="dbt/target/manifest.json"

# Olist seed data dir — defaults to the committed sample. Set to
# "data/raw/olist-dataset" to seed the full Kaggle dataset instead.
OLIST_DATA_DIR="data/seed/olist-sample"

# Prompt templates directory (relative to project root)
PROMPTS_DIR="prompts"

# LLM provider: "openai" or "openrouter"
LLM_PROVIDER="openai"

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# OpenRouter (used when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Langfuse — local dev: http://localhost:3000 | Docker: overridden to http://langfuse-web:3000 in docker-compose
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="http://langfuse-web:3000"

# Langfuse self-hosted infra — used by docker-compose only
LANGFUSE_PORT=3000
LANGFUSE_NEXTAUTH_SECRET="langfuse-dev-nextauth-secret-change-in-prod"
LANGFUSE_SALT="langfuse-dev-salt-change-in-prod"
LANGFUSE_POSTGRES_PASSWORD="langfuse"
LANGFUSE_CLICKHOUSE_USER="default"
LANGFUSE_CLICKHOUSE_PASSWORD="langfuse"
LANGFUSE_MINIO_ACCESS_KEY="minio"
LANGFUSE_MINIO_SECRET_KEY="miniosecret"
LANGFUSE_INIT_USER_EMAIL="admin@analytics-copilot.local"
LANGFUSE_INIT_USER_PASSWORD="copilotadmin123." # CHANGE IN PRODUCTION

# Legacy / reference — from OpenRAG skeleton
DATABASE_URL=""
QDRANT_HOST="qdrant"
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="openrag_documents"
